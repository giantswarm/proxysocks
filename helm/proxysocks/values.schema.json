{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "createSecret": {
                    "type": "boolean"
                },
                "enabled": {
                    "type": "boolean"
                },
                "existingSecret": {
                    "type": "string"
                },
                "htpasswd": {
                    "type": "string"
                }
            }
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "externalDNSIP": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "port": {
                    "type": "integer"
                },
                "serviceMonitor": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "podDisruptionBudget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "minAvailable": {
                    "type": "integer"
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string"
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "service.beta.kubernetes.io/aws-load-balancer-internal": {
                            "type": "string"
                        }
                    }
                },
                "port": {
                    "type": "integer"
                }
            }
        },
        "serviceType": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        }
    }
}
